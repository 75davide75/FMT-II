    "Accedi a iCloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud"
          }
        }
      }
    },
    "Accedi a iCloud nelle Impostazioni di iOS per avere voti, diario e orario su tutti i tuoi dispositivi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in iOS Settings to have grades, planner and timetable on all your devices."
          }
        }
      }
    },
    "Adesso": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now"
          }
        }
      }
    },
    "Adesso mostra l'ora corrente con la barra di avanzamento e la prossima ora; Giorno l'intera giornata; Settimana la griglia completa con le etichette colorate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now shows the current period with a progress bar and the next one; Day shows the whole day; Week shows the full grid with colored labels."
          }
        }
      }
    },
    "Aggiornata alle %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated at %@"
          }
        }
