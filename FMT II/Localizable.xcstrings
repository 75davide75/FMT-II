            "state": "translated",
            "value": "Every feature, section by section"
          }
        }
      }
    },
    "Tutte le modifiche fatte in questa schermata verranno annullate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All changes made on this screen will be discarded."
          }
        }
      }
    },
    "Tutte le voci del diario, archivio incluso, verranno eliminate. L'azione non è reversibile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All planner items, archive included, will be deleted. This cannot be undone."
